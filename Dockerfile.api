# Multi-stage Dockerfile for NestJS API
FROM node:20-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates curl && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@9.15.4

FROM base AS builder
WORKDIR /app
ENV NODE_ENV=development
COPY . .
RUN pnpm install --no-frozen-lockfile --prod=false
RUN pnpm --filter @simogu/types build
RUN pnpm --filter @simogu/api run prisma:generate
RUN pnpm --filter @simogu/api build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

# Copy built API & workspace packages
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/packages ./packages

# Copy Prisma schema and migrations for runtime migrate
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma

# Copy generated Prisma client and node_modules
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml

# Copy entrypoint script
COPY --from=builder /app/scripts/entrypoint-api.sh ./entrypoint-api.sh
RUN chmod +x ./entrypoint-api.sh

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:3001/api/v1/health || exit 1

ENTRYPOINT ["./entrypoint-api.sh"]
