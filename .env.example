# Node Environment
NODE_ENV=development
PORT=3001

# API Server Config
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://simogu_user:simogu_password_secret@localhost:5432/simogu_db?schema=public"

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production
JWT_REFRESH_EXPIRATION=7d

# WhatsApp Configuration (mock | cloud_api)
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=mock_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=mock_business_account_id
WHATSAPP_ACCESS_TOKEN=mock_access_token

# S3 Storage Configuration
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=simogu-attachments
S3_REGION=us-east-1

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
