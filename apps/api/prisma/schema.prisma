datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  SUPER_ADMIN
  ADMIN
  KETUA_PIKET
  PIKET
  GURU
  PIKET_PENGAJIAN
  KETUA_PIKET_PENGAJIAN
}

enum PengajianSession {
  PAGI
  ASHAR
  MAGHRIB
}

enum Gender {
  MALE
  FEMALE
}

enum SemesterType {
  ODD
  EVEN
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT_PENDING_CONFIRMATION
  PERMISSION
  SICK
  OFFICIAL_DUTY
  LATE
  WITHOUT_EXPLANATION
  CANCELLED
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WhatsAppStatus {
  PENDING
  SENT
  FAILED
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String?   @unique
  passwordHash String
  fullName     String
  role         Role      @default(PIKET)
  teacherId    String?   @unique
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  teacher                           Teacher?                  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  refreshTokens                     RefreshToken[]
  attendanceRecordsRecorded         AttendanceRecord[]        @relation("RecordedBy")
  attendanceStatusHistoriesChanged  AttendanceStatusHistory[] @relation("ChangedBy")
  attendanceChangeRequestsSubmitted AttendanceChangeRequest[] @relation("RequestedBy")
  attendanceChangeRequestsReviewed  AttendanceChangeRequest[] @relation("ReviewedBy")
  notifications                     Notification[]
  auditLogs                         AuditLog[]
  pengajianAttendanceRecorded       PengajianAttendance[]     @relation("PengajianAttendanceRecordedBy")

  @@index([username])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Teacher {
  id             String    @id @default(uuid())
  teacherCode    String    @unique
  nip            String?
  fullName       String
  gender         Gender
  whatsappNumber String
  subject        String
  photoUrl       String?
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user             User?
  homeroomClasses  Class[]           @relation("HomeroomTeacher")
  schedules        Schedule[]
  whatsappMessages WhatsAppMessage[]
  pengajianSchedules PengajianSchedule[]

  @@index([teacherCode])
  @@index([fullName])
}

model Class {
  id                String    @id @default(uuid())
  name              String
  grade             String
  major             String?
  homeroomTeacherId String?
  isActive          Boolean   @default(true)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  homeroomTeacher Teacher?   @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  schedules       Schedule[]

  @@index([name])
}

model LessonPeriod {
  id           String     @id @default(uuid())
  periodNumber Int
  startTime    String
  endTime      String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  schedules Schedule[]

  @@index([periodNumber])
}

model AcademicYear {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  semesters Semester[]
}

model Semester {
  id             String       @id @default(uuid())
  academicYearId String
  name           String
  type           SemesterType
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  schedules    Schedule[]

  @@index([academicYearId])
}

model SchoolHoliday {
  id          String   @id @default(uuid())
  name        String
  date        DateTime
  description String?
  createdAt   DateTime @default(now())

  @@index([date])
}

model Schedule {
  id              String    @id @default(uuid())
  teacherId       String
  classId         String
  lessonPeriodId  String
  semesterId      String
  dayOfWeek       DayOfWeek
  subject         String
  periodValidFrom DateTime
  periodValidTo   DateTime
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  teacher           Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class             Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  lessonPeriod      LessonPeriod       @relation(fields: [lessonPeriodId], references: [id], onDelete: Cascade)
  semester          Semester           @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]

  @@index([teacherId, dayOfWeek])
  @@index([classId, dayOfWeek])
  @@index([semesterId])
}

model AttendanceRecord {
  id             String           @id @default(uuid())
  scheduleId     String
  attendanceDate DateTime
  status         AttendanceStatus
  recordedById   String
  notes          String?
  attachmentUrl  String?
  attachmentType String?
  attachmentName String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt


  schedule        Schedule                  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  recordedBy      User                      @relation("RecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  statusHistories AttendanceStatusHistory[]
  changeRequests  AttendanceChangeRequest[]
  whatsappMessages WhatsAppMessage[]

  @@unique([scheduleId, attendanceDate])
  @@index([attendanceDate])
  @@index([status])
}

model AttendanceStatusHistory {
  id                 String            @id @default(uuid())
  attendanceRecordId String
  previousStatus     AttendanceStatus?
  newStatus          AttendanceStatus
  changedById        String
  reason             String
  createdAt          DateTime          @default(now())

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  changedBy        User             @relation("ChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([attendanceRecordId])
}

model AttendanceChangeRequest {
  id                 String              @id @default(uuid())
  attendanceRecordId String
  requestedById      String
  currentStatus      AttendanceStatus
  requestedStatus    AttendanceStatus
  reason             String
  status             ChangeRequestStatus @default(PENDING)
  reviewedById       String?
  reviewedAt         DateTime?
  reviewNotes        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  attendanceRecord AttendanceRecord          @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  requestedBy      User                      @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy       User?                     @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  attachments      ChangeRequestAttachment[]

  @@index([attendanceRecordId])
  @@index([status])
}

model ChangeRequestAttachment {
  id              String   @id @default(uuid())
  changeRequestId String
  fileUrl         String
  fileType        String
  fileSize        Int
  createdAt       DateTime @default(now())

  changeRequest AttendanceChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  @@index([changeRequestId])
}

model WhatsAppMessage {
  id                 String         @id @default(uuid())
  attendanceRecordId String?
  teacherId          String
  recipientPhone     String
  messageBody        String
  status             WhatsAppStatus @default(PENDING)
  failureReason      String?
  sentAt             DateTime?
  createdAt          DateTime       @default(now())

  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  teacher          Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// ==========================================
// PENGAJIAN PESANTREN (BOARDING SCHOOL) MODULE
// ==========================================

model PengajianClass {
  id          String    @id @default(uuid())
  name        String    // e.g. "Halaqah Al-Jurumiyah A", "Sorogan Fathul Qorib", "Tahfidz Putra 1"
  category    String    // "Kitab Kuning", "Tahfidz", "Sorogan", "Bandongan", "Diniyah"
  location    String?   // "Masjid Utama Lt. 1", "Asrama Umar bin Khattab", "Gedung Diniyah A"
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  schedules   PengajianSchedule[]

  @@index([name])
  @@index([category])
}

model PengajianSchedule {
  id               String           @id @default(uuid())
  pengajianClassId String
  teacherId        String           // Ustadz / Guru Pengampu
  session          PengajianSession // PAGI, ASHAR, MAGHRIB
  dayOfWeek        DayOfWeek        // MONDAY .. SUNDAY
  kitab            String           // e.g. "Kitab Fathul Qorib", "Jurumiyah", "Safinatun Najah", "Juz 30"
  timeSlot         String?          // e.g. "05:30 - 06:30", "16:00 - 17:00", "18:30 - 19:45"
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  pengajianClass   PengajianClass        @relation(fields: [pengajianClassId], references: [id], onDelete: Cascade)
  teacher          Teacher               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  attendances      PengajianAttendance[]

  @@index([pengajianClassId])
  @@index([teacherId])
  @@index([session])
  @@index([dayOfWeek])
}

model PengajianAttendance {
  id                  String           @id @default(uuid())
  pengajianScheduleId String
  attendanceDate      DateTime
  session             PengajianSession
  status              AttendanceStatus
  badalTeacherId      String?          // Ustadz Badal / Pengganti jika status BADAL/IZIN
  badalTeacherName    String?          // Nama ustadz pengganti jika dari luar
  notes               String?
  attachmentUrl       String?
  attachmentType      String?
  attachmentName      String?
  recordedById        String
  createdAt           DateTime         @default(now())

  updatedAt           DateTime         @updatedAt

  schedule            PengajianSchedule @relation(fields: [pengajianScheduleId], references: [id], onDelete: Cascade)
  recordedBy          User              @relation("PengajianAttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([pengajianScheduleId, attendanceDate])
  @@index([attendanceDate])
  @@index([session])
  @@index([status])
}

