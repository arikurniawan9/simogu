{
  "name": "simogu-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"@simogu/*\" dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "share": "powershell -ExecutionPolicy Bypass -File ./start-tunnel.ps1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
